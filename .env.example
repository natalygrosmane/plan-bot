# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_IDS=123456789

# AI Provider for Voice Transcription & Smart Planning
# Options: "gemini" (recommended), "groq", or "openai"
AI_PROVIDER=gemini

# API Keys (fill at least one based on AI_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
GROQ_API_KEY=

# Local Timezone (e.g., Asia/Bangkok, Europe/Moscow, Europe/Nicosia, etc.)
TIMEZONE=Asia/Bangkok
